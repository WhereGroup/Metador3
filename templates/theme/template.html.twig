{% extends 'theme/template_base.html.twig' %}

{% block css %}
    {% if app.environment == 'dev' %}
        {{ encore_entry_link_tags('app_dev') }}
    {% else %}
        {{ encore_entry_link_tags('app') }}
    {% endif %}
{% endblock %}


{% block javascript %}
    {{ parent() }}
    {% if app.environment == 'dev' %}
        {{ encore_entry_script_tags('app_dev') }}
    {% else %}
        {{ encore_entry_script_tags('app') }}
    {% endif %}
{% endblock %}